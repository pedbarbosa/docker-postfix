#!/usr/bin/env bash
# Image tests, run by docker-image-refresh after building a new image and
# before tagging it 'latest'. Usage: ./test <image>

# The check functions are called indirectly, through 'check'
# shellcheck disable=SC2329

set -euo pipefail

if [ $# -ne 1 ]; then
    echo "Usage: $0 <image>" >&2
    exit 2
fi
IMAGE=$1

FAILED=0
CONTAINER="postfix-test-$$"

cleanup() {
    docker rm --force "$CONTAINER" >/dev/null 2>&1 || true
}
trap cleanup EXIT

check() {
    local name=$1 output
    shift
    if output=$("$@" 2>&1); then
        echo "PASS: $name"
    else
        echo "FAIL: $name"
        [ -z "$output" ] || echo "    ${output//$'\n'/$'\n'    }"
        FAILED=1
    fi
}

in_container() {
    docker exec "$CONTAINER" "$@"
}

# Starts the image as it ships, with no /config, for the checks that need it
# running
starts() {
    docker run --detach --name "$CONTAINER" "$IMAGE" >/dev/null
}

postfix_running() {
    for _ in {1..15}; do
        in_container postfix status >/dev/null 2>&1 && return 0
        sleep 2
    done
    docker logs --tail 20 "$CONTAINER"
    return 1
}

config_valid() {
    in_container postfix check
}

# Waits for the greeting before sending, as Postfix rejects clients that
# talk first
answers_smtp() {
    local reply
    reply=$(in_container sh -c '(sleep 2; echo QUIT) | nc -w 5 127.0.0.1 25') || return 1
    grep -q '^220 ' <<<"$reply" || { echo "$reply"; return 1; }
}

# Also checks rsyslog, which writes Postfix's log
delivers_local_mail() {
    printf 'Subject: image test\n\nTest message\n' | docker exec -i "$CONTAINER" sendmail root@localhost || return 1
    for _ in {1..10}; do
        in_container grep -q 'to=<root@localhost>.*status=sent' /var/log/maillog 2>/dev/null && return 0
        sleep 2
    done
    in_container tail -5 /var/log/maillog
    return 1
}

# Fails when Alpine's repositories can't be reached, as well as when
# packages are out of date
packages_up_to_date() {
    local output
    output=$(docker run --rm "$IMAGE" apk upgrade --no-cache --simulate 2>&1) || { echo "$output"; return 1; }
    ! grep 'Upgrading' <<<"$output"
}

echo "Testing '$IMAGE' ..."
check "container starts" starts
check "Postfix is running" postfix_running
check "Postfix config is valid" config_valid
check "answers SMTP on port 25" answers_smtp
check "delivers a local message" delivers_local_mail
check "Alpine packages are up to date" packages_up_to_date

exit $FAILED
